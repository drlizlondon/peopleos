    "still": "remotion still src/index.ts PeopleOSDontFeelGuilty out/peopleos-dont-feel-guilty-end-card.png --frame=360"
  },
  "dependencies": {
    "@remotion/cli": "4.0.496",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.496"
  },
  "devDependencies": {
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "typescript": "5.5.3"
  }
